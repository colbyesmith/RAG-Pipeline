# Get a key from https://console.mistral.ai/ — never commit real keys.
MISTRAL_API_KEY=your_mistral_api_key_here

# Mistral: larger batches + zero delay speed ingest; raise delay if you see 429s on embeddings.
MISTRAL_API_MAX_RETRIES=5
MISTRAL_API_RETRY_BASE_SECONDS=1.0
MISTRAL_EMBED_BATCH_SIZE=128
MISTRAL_EMBED_BATCH_DELAY_MS=0

# PDF: skip pypdf when PyMuPDF already extracted enough text (faster). Set PDF_EXTRACT_FAST=false for max quality.
PDF_EXTRACT_FAST=true
PDF_FITZ_MIN_CHARS_SKIP_PYPDF=48

# Approximate dense retrieval (FAISS HNSW). Disable with RAG_ANN_ENABLED=false.
RAG_ANN_ENABLED=true
RAG_ANN_MIN_CHUNKS=384
RAG_ANN_NEIGHBORS=512
RAG_ANN_HNSW_M=32
RAG_ANN_EF_CONSTRUCTION=200
RAG_ANN_EF_SEARCH=128

# Optional tuning
RAG_TOP_K=8
RAG_SIMILARITY_THRESHOLD=0.32
RAG_RRF_K=60
UPLOAD_MAX_MB=25

# Chunking: larger = fewer chunks & faster ingest (fewer Mistral embed calls). Smaller = finer citations.
# ~800/120 is a balanced default; use e.g. 400/80 for finer slices.
CHUNK_SIZE_CHARS=800
CHUNK_OVERLAP_CHARS=120

# Cross-encoder rerank (on by default; sentence-transformers in requirements.txt). Set false to skip.
RAG_CROSS_ENCODER_ENABLED=true
RAG_RETRIEVE_K=24
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Multi-hop: candidate pool size for the merged first+second hop (second hop always runs when LLM proposes a follow-up).
RAG_MULTI_HOP_POOL_K=20

# Evidence check: min token Jaccard (sentence vs retrieved context) to avoid a weak-overlap flag. Lower = fewer flags.
EVIDENCE_OVERLAP_MIN=0.10
