# Get a key from https://console.mistral.ai/ — never commit real keys.
MISTRAL_API_KEY=your_mistral_api_key_here

# Mistral rate limits: retries (429/503), smaller batches, pause between embed batches on ingest
MISTRAL_API_MAX_RETRIES=5
MISTRAL_API_RETRY_BASE_SECONDS=1.0
MISTRAL_EMBED_BATCH_SIZE=8
MISTRAL_EMBED_BATCH_DELAY_MS=250

# Optional tuning
RAG_TOP_K=8
RAG_SIMILARITY_THRESHOLD=0.32
RAG_RRF_K=60
UPLOAD_MAX_MB=25

# Chunking: smaller = more vectors, finer locality (~4 chars ≈ 1 token for English).
CHUNK_SIZE_CHARS=80
CHUNK_OVERLAP_CHARS=20

# Cross-encoder rerank (pip install -r requirements-cross-encoder.txt)
RAG_CROSS_ENCODER_ENABLED=false
RAG_RETRIEVE_K=24
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Multi-hop retrieval (second search, merged with first hop)
RAG_MULTI_HOP_ENABLED=false
RAG_MULTI_HOP_POOL_K=20
